# ==============================================================================
# Quantum AI Precision Agriculture Platform - Backend Environment Configuration
# ==============================================================================

# Server Network Settings
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=production
DEBUG=false

# Allowed CORS Origins (Comma-separated list or * for all)
# Example: http://localhost:3000,http://localhost:5173,https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://*.vercel.app,http://127.0.0.1:8000

# SQLite / PostgreSQL Database URI
# Default: sqlite:///./precision_agri.db
DATABASE_URL=sqlite:///./precision_agri.db

# Weather & Geospatial API Endpoints (Optional Overrides)
OPENMETEO_API_URL=https://api.open-meteo.com/v1
NASA_POWER_API_URL=https://power.larc.nasa.gov/api/temporal/daily/point
OPENWEATHER_API_KEY=

# Quantum Backend Settings (Optional - uses PennyLane default.qubit simulator)
IBM_QUANTUM_TOKEN=
QUANTUM_DEVICE=default.qubit
QUANTUM_SHOTS=1024
